# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Токен Hugging Face (бесплатный, https://huggingface.co/settings/tokens).
# Не обязателен, но с ним больше бесплатной GPU-квоты на Spaces.
HF_TOKEN=

# Какие бесплатные модели (Hugging Face Spaces) использовать.
# Можно указать несколько через запятую — бот попробует по очереди.
# Формат: owner/space или owner/space@/api_name
TEXT2VIDEO_SPACES=Lightricks/ltx-video-distilled,Wan-AI/Wan2.1
IMG2VIDEO_SPACES=Lightricks/ltx-video-distilled
FACESWAP_VIDEO_SPACES=tonyassi/video-face-swap
FACESWAP_IMAGE_SPACES=tonyassi/face-swap,felixrosberg/face-swap

# Плавное появление/затухание готового видео (нужен ffmpeg), 0 — выключить
FADE_SECONDS=0.6

# Сколько секунд ждать одну модель, потом бот переключится на следующую
JOB_TIMEOUT=600

# Автопоиск: если заданные модели выключены/на слабом CPU, бот сам найдёт на HF
# работающие модели (сначала на GPU). /models в боте показывает, что он нашёл.
AUTO_DISCOVER=1
MAX_MODEL_TRIES=4

# Входящее видео для замены лица обрезается до стольких секунд и такого размера
# (замена лица идёт покадрово — длинные видео на бесплатных моделях считаются очень долго)
MAX_VIDEO_SECONDS=10
MAX_VIDEO_SIDE=720
VIDEO_FPS=24

# Сколько задач генерации одновременно (на бесплатном тарифе лучше 1-2)
MAX_PARALLEL_JOBS=2

# Webhook-режим. На Render заполняется автоматически (RENDER_EXTERNAL_URL).
# Если пусто — бот работает через long polling (удобно локально).
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
PORT=8080
